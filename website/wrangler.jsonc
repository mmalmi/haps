{
  "name": "haps-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "haps.hashtree.cc", "custom_domain": true },
    { "pattern": "haps.hashtree.cc/*", "zone_name": "hashtree.cc" },
    { "pattern": "haps.iris.to", "custom_domain": true }
  ]
}
